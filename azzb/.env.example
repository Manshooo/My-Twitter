# Скопируйте в azzb/.env и заполните. Файл .env в git не попадает.

DJANGO_SECRET_KEY=замените-на-длинную-случайную-строку
# true — режим разработки (debug toolbar, раздача media). На проде не задавать.
DJANGO_DEBUG=

# Пароль SMTP для писем (сброс пароля).
EMAIL_HOST_PASSWORD=

# PostgreSQL — обязателен: без POSTGRES_DB сайт не запустится.
# Для разработки: роль с правом CREATEDB (нужно тестам), например
#   CREATE ROLE azzb LOGIN CREATEDB PASSWORD 'azzb'; CREATE DATABASE azzb OWNER azzb;
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Сколько секунд держать соединение открытым между запросами (0 — закрывать сразу).
POSTGRES_CONN_MAX_AGE=60
