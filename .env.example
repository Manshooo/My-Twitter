# Скопируйте в .env (рядом с manage.py) и заполните. Файл .env в git не попадает.

DJANGO_SECRET_KEY=замените-на-длинную-случайную-строку
# true — режим разработки (debug toolbar, раздача media). На проде не задавать.
DJANGO_DEBUG=

# Почта. По умолчанию: при DJANGO_DEBUG=true письма печатаются в консоль, на проде уходят
# через Postfix на localhost:25 без пароля (docs/deploy/mail.md). Переопределять, только если
# нужен внешний SMTP, например временно, пока Postfix не настроен:
#   EMAIL_HOST=smtp.mail.ru  EMAIL_PORT=2525  EMAIL_USE_TLS=true
#   EMAIL_HOST_USER=information@azzb.ru  EMAIL_HOST_PASSWORD=...  DEFAULT_FROM_EMAIL=information@azzb.ru
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
DEFAULT_FROM_EMAIL=

# Контакты и оператор персональных данных — для правил, политики конфиденциальности и экрана бана.
# SUPPORT_EMAIL — ящик, который вы читаете (на azzb.ru почта только отправляется).
SUPPORT_EMAIL=
LEGAL_OPERATOR=

# Yandex SmartCaptcha на регистрации (E2): ключи из консоли Yandex Cloud → SmartCaptcha.
# Пусто — капча выключена.
SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=

# Заголовок с настоящим IP посетителя от nginx (лимиты частоты). На проде по умолчанию
# X-Real-IP, при DJANGO_DEBUG=true — не используется. См. docs/deploy/security.md.
CLIENT_IP_HEADER=

# PostgreSQL — обязателен: без POSTGRES_DB сайт не запустится.
# Для разработки: роль с правом CREATEDB (нужно тестам), например
#   CREATE ROLE azzb LOGIN CREATEDB PASSWORD 'azzb'; CREATE DATABASE azzb OWNER azzb;
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Сколько секунд держать соединение открытым между запросами (0 — закрывать сразу).
POSTGRES_CONN_MAX_AGE=60
